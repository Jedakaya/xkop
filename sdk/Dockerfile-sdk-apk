# Prepared OpenWrt SDK for apk builds.
#
# Everything slow lives here and nowhere else: unpacking the SDK and updating
# the feeds takes minutes, and it has nothing to do with our code. The image is
# built when the SDK release changes - which is a few times a year - and every
# package build after that starts from a ready tree.
#
# The SDK release is pinned rather than tracking SNAPSHOT: SNAPSHOT is rebuilt
# daily, and a build that cannot be repeated a month later is not a build.
FROM openwrt/sdk:x86-64-25.12.0

# Links the package to the repository in GHCR. Without it the image is created
# unattached, and the repository's own Actions token gets 403 on pull - the
# build then fails on FROM, not on anything of ours.
LABEL org.opencontainers.image.source="https://github.com/Jedakaya/xkop"

WORKDIR /builder

# setup.sh unpacks the SDK in newer images; older ones do not ship it.
RUN [ -x ./setup.sh ] && ./setup.sh || true

# The feed index only. Installing the dependency packages themselves makes the
# build compile them from source - curl with all its configure steps - and turns
# a build of seconds into one of many minutes. We need them as a line in the
# package metadata; building them is the router's business, from its own
# repository.
RUN ./scripts/feeds update -a \
    && mkdir -p /builder/package/feeds/utilities/
