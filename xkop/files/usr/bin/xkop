#!/bin/sh
# shellcheck shell=ash
# xkop - traffic router for OpenWrt on Xray-core.
#
# Command surface, not implementation: every command lives in a library under
# /usr/lib/xkop and prints JSON. Human readable output goes to the log, not to
# stdout - the client panel and LuCI parse what they get here.

XKOP_LIB_DIR='/usr/lib/xkop'

. "$XKOP_LIB_DIR/constants.sh"
. "$XKOP_LIB_DIR/logging.sh"
. "$XKOP_LIB_DIR/version.sh"
. "$XKOP_LIB_DIR/stats.sh"
. "$XKOP_LIB_DIR/subscription.sh"
. "$XKOP_LIB_DIR/config.sh"
. "$XKOP_LIB_DIR/lists.sh"
. "$XKOP_LIB_DIR/userlists.sh"
. "$XKOP_LIB_DIR/nft.sh"
. "$XKOP_LIB_DIR/dnsmasq.sh"
. "$XKOP_LIB_DIR/canary.sh"
. "$XKOP_LIB_DIR/nodes.sh"
. "$XKOP_LIB_DIR/diagnostics.sh"
. "$XKOP_LIB_DIR/explain.sh"
. "$XKOP_LIB_DIR/update.sh"
. "$XKOP_LIB_DIR/service.sh"

# Собрать конфигурацию движка из подписок и привязок. Отдаёт результат полем,
# а не кодом возврата: «оставлена прежняя» — это не отказ команды.
cmd_configure() {
    local rc reason

    config_generate
    rc=$?

    case "$rc" in
        0) reason="installed" ;;
        2) reason="unchanged" ;;
        *) reason="kept_previous" ;;
    esac

    jq -nc --arg reason "$reason" --arg path "$XKOP_CONFIG_PATH" \
        --argjson nodes "$(subscription_pool_all | jq 'length')" \
        --argjson exists "$([ -f "$XKOP_CONFIG_PATH" ] && echo true || echo false)" \
        '{ok: ($reason != "kept_previous"), result: $reason, path: $path,
          nodes: $nodes, config_present: $exists}'
}

# Состояние движка. Поля именуются по роли, а не по названию движка: панель
# и LuCI не должны знать, что внутри — см. docs/cli-contract.md.
cmd_check_engine() {
    local installed=0 version="" version_ok=0 hysteria2=0
    local service_exist=0 autostart_disabled=0 running=0 answering=0

    if command -v "$XKOP_ENGINE_BIN" > /dev/null 2>&1; then
        installed=1
        version=$("$XKOP_ENGINE_BIN" version 2> /dev/null | head -n 1 | awk '{print $2}')
        if [ -n "$version" ]; then
            version_ok=1
            engine_supports hysteria2 "$version" && hysteria2=1
        fi
    fi

    [ -f /etc/init.d/xkop ] && service_exist=1
    [ -x /etc/rc.d/S99xkop ] || autostart_disabled=1
    engine_process_running && running=1
    engine_answers && answering=1

    jq -nc \
        --arg version "$version" \
        --argjson installed "$installed" --argjson version_ok "$version_ok" \
        --argjson hysteria2 "$hysteria2" --argjson service_exist "$service_exist" \
        --argjson autostart_disabled "$autostart_disabled" \
        --argjson running "$running" --argjson answering "$answering" \
        '{
            engine_installed: ($installed == 1),
            engine_version: (if $version == "" then null else $version end),
            engine_version_ok: ($version_ok == 1),
            engine_supports_hysteria2: ($hysteria2 == 1),
            engine_service_exist: ($service_exist == 1),
            engine_autostart_disabled: ($autostart_disabled == 1),
            engine_process_running: ($running == 1),
            engine_answering: ($answering == 1)
        }'
}

cmd_show_engine_config() {
    if [ -s "$XKOP_CONFIG_PATH" ]; then
        cat "$XKOP_CONFIG_PATH"
    else
        jq -nc --arg path "$XKOP_CONFIG_PATH" \
            '{ok: false, error: "no_config", detail: {path: $path}}'
    fi
}

# Subscriptions, as the panel and LuCI see them: state, reason, what the panel
# itself said, and how many servers came out. Never empty and never a bare
# failure - see docs/cli-contract.md.
cmd_subscriptions() {
    local id first=1

    printf '['
    for id in $(subscription_ids); do
        [ "$first" -eq 1 ] || printf ','
        first=0
        jq -nc \
            --argjson meta "$(subscription_meta "$id")" \
            --argjson panel "$(subscription_panel "$id")" \
            --argjson userinfo "$(subscription_userinfo_of "$id")" \
            '$meta + {panel: $panel, userinfo: $userinfo}'
    done
    printf ']\n'
}

# Человек, нажавший «обновить», ждёт запроса к панели, а не рассказа
# про расписание. По расписанию обновляется то, чему пора, — это делает
# задача cron, а не эта команда.
cmd_subscription_update() {
    if [ -n "${1:-}" ]; then
        subscription_update "$1"
    else
        subscription_update_all force
    fi
    cmd_subscriptions
}

# Compatibility shape: podkop returns an array with a "section" key, and the
# client panel reads exactly that. The new name is "subscription"; the old key
# is kept beside it so an unchanged panel keeps working.
cmd_subscription_userinfo() {
    local id first=1

    printf '['
    for id in $(subscription_ids); do
        [ "$(subscription_userinfo_of "$id")" = "null" ] && continue
        [ "$first" -eq 1 ] || printf ','
        first=0
        jq -nc --arg id "$id" --argjson info "$(subscription_userinfo_of "$id")" \
            '{subscription: $id, section: $id} + $info'
    done
    printf ']\n'
}

show_help() {
    cat << 'EOF'
xkop - маршрутизатор трафика на Xray-core

Команды:
  stats                      метрики движка: трафик по исходящим,
                             распределение, состояние узлов
  subscriptions              состояние подписок: что в кэше и что сказала
                             панель
  subscription_update [id]   обновить подписку или все сразу
  get_subscription_userinfo  трафик и срок из заголовка подписки
  explain <домен>            куда ушёл этот домен и почему
  recent [сколько]           какие домены куда уходили в последнее время
  nodes                      узлы пула: состояние и какой выбран сейчас
  select <тег|auto>          закрепить узел вручную или вернуть автовыбор
  canary                     проверка подмены DNS провайдером
  get_status                 состояние службы, движка и правил
  global_check               всё сразу и одной строкой, что не так
  check_dns_available        отвечает ли резолвер
  check_fakeip               выдаются ли поддельные адреса
  check_nft_rules            есть ли правила и шёл ли через них трафик
  check_logs [строк]         последние записи в журнале
  get_system_info            роутер, место, память, версия
  check_engine               установлен ли движок, поднялся ли, отвечает ли
  configure                  собрать конфигурацию движка
  show_engine_config         показать установленную конфигурацию
  start / stop / restart     управление службой
  check_update               есть ли новая версия
  update                     обновить пакеты с откатом при неудаче
  version                    версия пакета
  help                       эта справка

Всё, кроме help, выводит JSON. Нулевой код возврата означает, что команда
отработала, а не что всё хорошо: состояние передаётся полями.
EOF
}

main() {
    local command="$1"
    [ $# -gt 0 ] && shift

    case "$command" in
        stats)
            cmd_stats "$@"
            ;;
        subscriptions)
            cmd_subscriptions
            ;;
        subscription_update)
            cmd_subscription_update "$@"
            ;;
        subscription_refresh)
            # Задача по расписанию: спрашивает только те подписки, которым
            # пора по их собственному интервалу.
            subscription_update_all
            cmd_subscriptions
            ;;
        get_subscription_userinfo)
            cmd_subscription_userinfo
            ;;
        lists_update)
            lists_update
            jq -nc \
                --argjson present "$(lists_present && echo true || echo false)" \
                --arg path "$(lists_geosite_path)" \
                '{ok: $present,
                  result: (if $present then "present" else "missing" end),
                  path: $path}'
            ;;
        explain)
            explain_domain "${1:-}"
            ;;
        recent)
            explain_recent "${1:-20}"
            ;;
        access_trim)
            access_trim
            jq -nc '{ok: true, result: "trimmed"}'
            ;;
        nodes)
            nodes_json
            ;;
        select)
            nodes_select "${1:-auto}"
            ;;
        canary)
            # Если выученное изменилось, движок держит конфигурацию, которая
            # больше не соответствует тому, что мы знаем про эту сеть.
            canary_state_json
            if [ -s "$XKOP_RUN_DIR/canary.json" ]                && [ "$(jq -r ".changed" "$XKOP_RUN_DIR/canary.json")" = "true" ]; then
                config_generate > /dev/null 2>&1 && /etc/init.d/xkop restart > /dev/null 2>&1
            fi
            ;;
        userlists_update)
            userlist_update_all
            ;;
        update)
            update_apply
            ;;
        check_update)
            update_check_json
            ;;
        configure)
            cmd_configure
            ;;
        prepare)
            if service_prepare; then
                jq -nc '{ok: true, result: "prepared"}'
            else
                jq -nc '{ok: false, error: "nothing_to_run", detail: {config_present: false}}'
            fi
            ;;
        wan_up)
            service_on_wan_up
            jq -nc '{ok: true, result: "wan_up"}'
            ;;
        teardown)
            service_teardown
            jq -nc '{ok: true, result: "torn_down"}'
            ;;
        get_system_info | show_system_info)
            diag_system_json
            ;;
        check_nft_rules)
            diag_nft_json
            ;;
        check_logs)
            diag_logs_json "${1:-50}"
            ;;
        check_dns_available)
            diag_dns_json
            ;;
        check_fakeip)
            diag_fakeip_json
            ;;
        global_check)
            diag_global_json
            ;;
        started_check)
            service_started_check
            ;;
        dashboard)
            diag_dashboard_json
            ;;
        service)
            service_control "${1:-status}"
            ;;
        get_status)
            service_status_json
            ;;
        check_engine | check_sing_box)
            cmd_check_engine
            ;;
        start | stop | restart | enable | disable)
            # Служба живёт в procd, и решение о процессе принимает он.
            /etc/init.d/xkop "$command" > /dev/null 2>&1
            jq -nc --arg action "$command" '{ok: true, result: $action}'
            ;;
        show_engine_config | show_sing_box_config)
            cmd_show_engine_config
            ;;
        version | --version | -v)
            printf '{"version":"%s"}\n' "$XKOP_VERSION"
            ;;
        help | --help | -h | '')
            show_help
            ;;
        *)
            # The command did not run at all, and that is the one case where a
            # non-zero exit code carries meaning. Built through jq because the
            # name comes from outside and a quote in it would otherwise produce
            # broken JSON.
            jq -nc --arg command "$command" \
                '{ok: false, error: "unknown_command", detail: {command: $command}}'
            return 1
            ;;
    esac
}

main "$@"
