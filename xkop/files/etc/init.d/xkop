#!/bin/sh /etc/rc.common
# shellcheck shell=ash disable=SC2034

START=99
USE_PROCD=1

NAME=xkop
CONFIG=/etc/xkop/config.json

# rc.common задаёт initscript сам; запасное значение — на случай запуска
# файла напрямую, минуя обвязку.
initscript=${initscript:-/etc/init.d/xkop}

start_service() {
    # Everything that must happen before the engine: scheduled jobs, the
    # subscriptions, the configuration, the firewall rules. The order lives in
    # service.sh and is not incidental.
    /usr/bin/xkop prepare

    [ -s "$CONFIG" ] || {
        echo "xkop: конфигурации нет, движок не запускается"
        return 0
    }

    # procd owns the engine process: it restarts it if it dies, and it is the
    # one place where that decision belongs.
    procd_open_instance engine
    procd_set_param command /usr/bin/xray run -c "$CONFIG"
    # Где лежат списки, движку сообщается явно: искать он умеет в нескольких
    # местах, и молчаливый промах превращается в отказ загрузки конфигурации.
    procd_set_param env XRAY_LOCATION_ASSET=/usr/share/xray
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

start_service_done() {
    # Движок спрашивают, а не предполагают: процесс в списке может быть старым,
    # а эндпоинт метрик отвечает только когда поднялся наш. Не ответил —
    # взводится фоновое восстановление, потому что при включении роутера WAN
    # обычно ещё не готов и чинить это некому.
    /usr/bin/xkop started_check > /dev/null 2>&1 || true
}

stop_service() {
    /usr/bin/xkop teardown
}

reload_service() {
    restart
}

service_triggers() {
    # Перезапуск при правке настроек. Форма взята у podkop дословно:
    # procd_add_config_trigger внутри своего блока триггеров, с явным
    # указанием файла службы и действия. Смена списков в интерфейсе иначе
    # сохранялась в uci и не доезжала до движка — настройки менялись,
    # маршрутизация нет.
    PROCD_RELOAD_DELAY=2000

    # Подъём интерфейса. При старте роутера WAN обычно ещё не готов: подписки
    # не приезжают, и роутер поднимается на кэше или вовсе без узлов. Когда
    # интернет появляется, xkop добирает недостающее сам, без вмешательства.
    local interfaces
    interfaces=$(uci -q get xkop.settings.wan_interface)
    [ -n "$interfaces" ] || interfaces="wan"

    procd_open_trigger
    procd_add_config_trigger "config.change" "xkop" "$initscript" restart

    local iface
    for iface in $interfaces; do
        procd_add_interface_trigger "interface.*.up" "$iface" /usr/bin/xkop wan_up
    done
    procd_close_trigger
}
