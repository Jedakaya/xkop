config settings 'settings'
	# off    имена распознаются по самому соединению, dnsmasq не трогается
	# fakeip движок отвечает поддельными адресами на маршрутизируемые имена,
	#        dnsmasq переключается на него; проверяется на железе
	option dns_mode 'off'
	option dns_type 'doh'
	option dns_server '8.8.8.8/dns-query'
	option dns_bootstrap '77.88.8.8'
	option dns_parallel '0'
	#list dns_extra_server 'dot:1.1.1.1'
	option canary_enabled '1'
	option canary_interval '2m'
	#list canary_learned_ip '46.191.166.9'
	option block_client_doh '0'
	option block_https_records '0'
	option block_ptr_records '0'
	option block_firefox_canary '0'
	list source_interface 'br-lan'
	option wan_interface 'wan'
	option output_interface ''
	#list excluded_source_ip '192.168.1.3'
	option lists_update_interval '1d'
	option log_level 'warn'
	option metrics_port '11111'
	option dont_touch_dhcp '0'
	option exclude_ntp '0'
	option disable_quic '0'

# The direct and blocked channels always exist - bindings refer to them and
# they are not removable. See docs/uci-schema.md for the full schema.
config channel 'direct'
	option type 'direct'

config channel 'blocked'
	option type 'block'

# The tunnel channel is ready before there is anything to put in it. Without a
# subscription its pool is empty, the bindings pointing at it fall through to
# direct, and the router starts - an absent subscription makes a channel
# inactive, never fatal.
config channel 'tunnel'
	option type 'subscription'
	list subscription 'main'
	option strategy 'leastPing'

# Add the link and the subscription starts working:
#   uci set xkop.main.url='https://…' && uci commit xkop && /etc/init.d/xkop restart
config subscription 'main'
	option enabled '1'
	option url ''
	option update_interval '1h'

# Категории проверены на самом файле списков: russia-inside, geoblock, block,
# youtube, discord, meta, news, porn, hdrezka, anime.
config profile 'blocked_ru'
	option title 'Заблокированное в РФ'
	list community_list 'russia-inside'
	list community_list 'geoblock'

config binding 'b1'
	option profile 'blocked_ru'
	option channel 'tunnel'
	option order '10'
