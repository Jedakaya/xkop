#!/bin/sh
# shellcheck shell=ash
# Вход по паролю роутера.
#
# Ограничение попыток здесь не украшение: без него точка входа превращается
# в оракул, который отвечает так быстро, как роутер успевает считать хэш.
. "$(dirname "$0")/_common"

DATA=$(read_post)
PASS=$(urldecode "$(post_field "$DATA" password)"; printf '.')
PASS=${PASS%.}

NOW=$(date +%s)
FAILS=0
LAST=0
if [ -f "$FAIL_FILE" ]; then
    FAILS=$(head -n 1 "$FAIL_FILE" 2>/dev/null); [ -n "$FAILS" ] || FAILS=0
    LAST=$(sed -n '2p' "$FAIL_FILE" 2>/dev/null); [ -n "$LAST" ] || LAST=0
    [ $((NOW - LAST)) -gt 900 ] && FAILS=0
fi

if [ "$FAILS" -ge 5 ]; then
    header_json
    echo '{"ok":false,"error":"too_many_attempts","retry_after_minutes":15}'
    exit 0
fi

grant() {
    local token tmp
    token=$(cat /proc/sys/kernel/random/uuid 2>/dev/null) || fail "auth_unavailable"
    [ -n "$token" ] || fail "auth_unavailable"
    tmp=$(mktemp "${TOKEN_FILE}.XXXXXX") || fail "auth_unavailable"
    if ! printf '%s\n%s\n' "$token" "$((NOW + TOKEN_TTL))" > "$tmp" || ! mv -f "$tmp" "$TOKEN_FILE"; then
        rm -f "$tmp"
        fail "auth_unavailable"
    fi
    rm -f "$FAIL_FILE"
    header_json
    printf '{"ok":true,"token":"%s"}\n' "$token"
    exit 0
}

# Blank/locked accounts and unreadable or malformed shadow are never setup login.
[ -r /etc/shadow ] || fail "auth_unavailable"
HASH=$(awk -F: '$1 == "root" && NF >= 2 { count++; hash=$2 } END { if (count != 1) exit 1; print hash }' /etc/shadow) || fail "auth_unavailable"
case "$HASH" in '' | '!'* | '*'*) fail "password_login_disabled" ;; esac

# rpcd uses the platform crypt verifier with the complete hash setting, including
# rounds and the algorithms supported by this firmware. No openssl dependency.
command -v ubus >/dev/null 2>&1 || fail "auth_unavailable"
REQUEST=$(jq -nc --arg password "$PASS" '{username:"root", password:$password, timeout:30}') || fail "auth_unavailable"
REPLY=$(ubus call session login "$REQUEST" 2>/dev/null)
SESSION=$(printf '%s' "$REPLY" | jq -er '.ubus_rpc_session | select(type == "string" and length == 32)' 2>/dev/null) || SESSION=
case "$SESSION" in '' | *[!a-fA-F0-9]*) SESSION= ;; esac
if [ -n "$SESSION" ]; then
    # Only our limited panel token survives; do not leak an admin rpcd session.
    ubus call session destroy "$(jq -nc --arg id "$SESSION" '{ubus_rpc_session:$id}')" >/dev/null 2>&1 || fail "auth_unavailable"
    grant
fi

printf '%s\n%s\n' "$((FAILS + 1))" "$NOW" > "$FAIL_FILE"
header_json
echo '{"ok":false,"error":"wrong_password"}'
