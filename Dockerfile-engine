# Build of the engine package for one architecture.
#
# One SDK, many architectures: the package carries a prebuilt binary, so what
# has to match the router is the metadata, not the toolchain. The architecture
# is passed in and the Makefile picks the matching XTLS asset by it.
ARG SDK_IMAGE=ghcr.io/jedakaya/xkop-sdk-apk:25.12.0
FROM ${SDK_IMAGE} AS build

ARG XKOP_TARGET_ARCH=x86_64
ARG XKOP_PACKAGE_TYPE=apk
ENV XKOP_TARGET_ARCH=${XKOP_TARGET_ARCH}

WORKDIR /builder

COPY ./xray-xkop /builder/package/feeds/utilities/xray-xkop

# Архитектура в описании пакета проверяется, а не подразумевается. Один раз
# она подразумевалась: PKGARCH стоял снаружи блока Package, Package/Default
# затирал его безусловно, и восемь пакетов уехали в релиз с arch: x86_64.
# Ничего не падало — роутер просто отверг пакет как «uninstallable».
RUN set -e; \
    make defconfig; \
    if ! make package/xray-xkop/compile -j1 V=s XKOP_TARGET_ARCH=${XKOP_TARGET_ARCH} > /tmp/build.log 2>&1; then \
        tail -n 80 /tmp/build.log; exit 1; \
    fi; \
    if [ "${XKOP_PACKAGE_TYPE}" = apk ] && ! grep -q "arch:${XKOP_TARGET_ARCH}" /tmp/build.log; then \
        echo "PKGARCH не доехал до пакета: ожидалась ${XKOP_TARGET_ARCH}"; \
        grep -o "arch:[^ \"]*" /tmp/build.log | sort -u; \
        exit 1; \
    fi; \
    if [ "${XKOP_PACKAGE_TYPE}" = ipk ]; then \
        pkg=$(find /builder/bin -name 'xray-xkop*.ipk' | head -n 1); \
        test -n "$pkg"; \
        control=$(tar -xzOf "$pkg" ./control.tar.gz | tar -xzOf - ./control); \
        printf '%s\n' "$control" | grep -Fx "Architecture: ${XKOP_TARGET_ARCH}"; \
    fi

RUN mkdir -p /builder/out \
    && find /builder/bin -name 'xray-xkop*' -exec cp {} /builder/out/ ';'

FROM scratch AS artifacts
COPY --from=build /builder/out/ /
