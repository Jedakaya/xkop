#!/bin/sh /etc/rc.common
# Dedicated lab only; not installed/enabled by public Xkop packages.
USE_PROCD=1
START=95
STOP=10
start_service() {
    [ "$(cat /lab/xkop-native-lab 2>/dev/null)" = 'DISPOSABLE OPENWRT ROOTFS' ] || return 1
    [ -f /etc/xkop/fleet/supervisor/guardian.sh ] || return 1
    procd_open_instance
    procd_set_param command /bin/sh /etc/xkop/fleet/supervisor/guardian.sh serve
    procd_set_param respawn 3600 5 0
    procd_set_param term_timeout 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
