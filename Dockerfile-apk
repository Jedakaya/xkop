# Build of the xkop apk package.
#
# Starts from a prepared SDK image (sdk/Dockerfile-sdk-apk), so a change in a
# shell script costs one make call and not a feeds update. Rebuild that image
# only when the SDK release changes.
#
# The package is PKGARCH:=all, so the x86-64 SDK produces something installable
# on any router. Only the package format depends on the SDK: 25.12 is apk.
ARG SDK_IMAGE=ghcr.io/jedakaya/xkop-sdk-apk:25.12.0
FROM ${SDK_IMAGE} AS build

ARG XKOP_VERSION
ENV XKOP_VERSION=${XKOP_VERSION}

WORKDIR /builder

COPY ./xkop /builder/package/feeds/utilities/xkop
COPY ./luci-app-xkop /builder/package/feeds/luci/luci-app-xkop

RUN make defconfig \
    && make package/xkop/compile -j1 V=s \
    && make package/luci-app-xkop/compile -j1 V=s

# The package is lifted out through an empty final stage: CI needs the file,
# not an image. Loading the built image into the daemon instead would move the
# whole SDK - gigabytes of it - for the sake of a few kilobytes.
RUN mkdir -p /builder/out \
    && find /builder/bin \( -name 'xkop*.apk' -o -name 'luci-app-xkop*.apk' \) \
        -exec cp {} /builder/out/ ';'

FROM scratch AS artifacts
COPY --from=build /builder/out/ /
