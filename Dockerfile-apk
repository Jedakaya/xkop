# Build of the xkop apk package.
#
# Starts from a prepared SDK image (sdk/Dockerfile-sdk-apk), so a change in a
# shell script costs one make call and not a feeds update. Rebuild that image
# only when the SDK release changes.
#
# The package is PKGARCH:=all, so the x86-64 SDK produces something installable
# on any router. Only the package format depends on the SDK: 25.12 is apk.
ARG SDK_IMAGE=ghcr.io/jedakaya/xkop-sdk-apk:25.12.0
FROM ${SDK_IMAGE}

ARG XKOP_VERSION
ENV XKOP_VERSION=${XKOP_VERSION}

WORKDIR /builder

COPY ./xkop /builder/package/feeds/utilities/xkop

RUN make defconfig \
    && make package/xkop/compile -j1 V=s
